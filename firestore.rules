rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             data.currentStreak is int && data.currentStreak >= 0 &&
             data.bestStreak is int && data.bestStreak >= 0 &&
             data.xp is int && data.xp >= 0 &&
             data.rank is string && data.rank.size() <= 50;
    }

    function isValidDayLog(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.date is string && data.date.size() == 10 &&
             data.status in ['CLEAN', 'RELAPSE', 'UNMARKED'] &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('urgeLevel' in data) || (data.urgeLevel is int && data.urgeLevel >= 0 && data.urgeLevel <= 3)) &&
             (!('triggerReason' in data) || (data.triggerReason is string && data.triggerReason.size() <= 200)) &&
             (!('penaltyAssigned' in data) || (data.penaltyAssigned is string && data.penaltyAssigned.size() <= 200)) &&
             (!('penaltyCompleted' in data) || data.penaltyCompleted is bool);
    }

    function isValidPunishment(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.category is string && data.category.size() <= 50 &&
             data.intensity is string && data.intensity in ['Leve', 'Moderada', 'Extrema'] &&
             data.isCompleted is bool &&
             data.dateAssigned is string && data.dateAssigned.size() <= 20;
    }

    function isValidJournalEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.mood is string && data.mood.size() <= 50 &&
             data.energyLevel is int && data.energyLevel >= 1 && data.energyLevel <= 5 &&
             data.reflection is string && data.reflection.size() <= 2000 &&
             (!('gratitude' in data) || (data.gratitude is string && data.gratitude.size() <= 500));
    }

    function isValidDailyMissions(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.date is string && data.date.size() == 10 &&
             data.workoutDone is bool &&
             data.coldShowerDone is bool &&
             data.screenDetoxDone is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'currentStreak', 'bestStreak', 'xp', 'rank', 'updatedAt']);

      allow delete: if isOwner(userId);

      // Subcollection: Day Records
      match /day_records/{date} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDayLog(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidDayLog(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().date == existing().date &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'urgeLevel', 'triggerReason', 'penaltyAssigned', 'penaltyCompleted', 'updatedAt']);

        allow delete: if isOwner(userId);
      }

      // Subcollection: Punishments
      match /punishments/{punishmentId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidPunishment(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidPunishment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'intensity', 'isCompleted', 'dateAssigned', 'updatedAt']);

        allow delete: if isOwner(userId);
      }

      // Subcollection: Journal Entries
      match /journal_entries/{entryId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['mood', 'energyLevel', 'reflection', 'gratitude']);

        allow delete: if isOwner(userId);
      }

      // Subcollection: Daily Missions
      match /daily_missions/{date} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDailyMissions(incoming()) &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidDailyMissions(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().date == existing().date &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['workoutDone', 'coldShowerDone', 'screenDetoxDone', 'updatedAt']);

        allow delete: if isOwner(userId);
      }
    }
  }
}
